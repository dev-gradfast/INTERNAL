# =============================================
# HORILLA HRMS - Environment Configuration
# =============================================

# Security - Set to False in production
DEBUG=False

# Generate a secure key at: https://djecrety.ir/
# Example: django-insecure-9x7K#mL2$vNpQ5rS8_tU4wX1@yZ6hB3cD2eF5gH7
SECRET_KEY=

# Your domain(s) - NEVER use "*" in production
# Example: mycompany.onrender.com,www.mycompany.com
ALLOWED_HOSTS=

# Timezone
TIME_ZONE=Asia/Kolkata

# =============================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# =============================================

# Get these from Supabase Dashboard → Settings → API
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=xxxxx.supabase.co
DB_PORT=5432

# =============================================
# CLOUDINARY FILE STORAGE (Optional)
# =============================================

# Get these from Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================
# SMTP EMAIL (Optional - for notifications)
# =============================================

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# =============================================
# ESSL BIOMETRIC DEVICE (Optional)
# =============================================

# Biometric device settings for eSSL attendance integration
# ESSL_DEVICE_IP=192.168.1.100
# ESSL_DEVICE_PORT=4370
# ESSL_DEVICE_PASSWORD=0